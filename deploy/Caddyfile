{
	admin off
}

# HTTPS is the host's Caddy; this one only serves files on the loopback port.
:8080 {
	encode zstd gzip
	root * /srv

	# Vite fingerprints everything under /assets. A missing one (an old tab
	# after a deploy) must 404, not fall back to index.html.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is re-checked so a deploy shows up straight away.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
